# Base URL of the Cuddle Corners backend.
#
# Production (what the deployed build must use):
#   VITE_API_URL=https://app.cuddlecorners.com
#
# Local development against a backend running on your machine:
#   VITE_API_URL=http://localhost:3002
#
# NOTE: Vite inlines this at BUILD time. Building with the wrong value ships a
# frontend that calls the wrong host. Always build on the server, or verify
# .env before running `npm run build`.
VITE_API_URL=https://app.cuddlecorners.com
